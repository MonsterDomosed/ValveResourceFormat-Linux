<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>UI-toolkit-agnostic types, settings, logging and platform service contracts shared by the Windows (WinForms) and Linux (Avalonia) GUI shells.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.2" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Renderer\Renderer.csproj" />
    <ProjectReference Include="..\ValveResourceFormat\ValveResourceFormat.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared graph renderer draws these icons; link them so the renderer resolves them by
         logical name from this assembly while the graph code lives here. -->
    <EmbeddedResource Include="..\GUI.Linux\Assets\Icons\About.svg" LogicalName="GUI.Linux.Icons.About.svg" />
    <EmbeddedResource Include="..\GUI.Linux\Assets\Icons\AssetTypes\*.svg" LogicalName="GUI.Linux.Icons.AssetTypes.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
