<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Native Linux GUI shell for Source 2 Viewer, built on Avalonia.</Description>
    <AssemblyName>Source2Viewer</AssemblyName>
    <RootNamespace>GUI.Linux</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- A self-contained single-file build is reliable here: SkiaSharp and Avalonia native assets
         are extracted alongside the app on first run. Only applies to RID-specific publishes so
         the plain solution build stays framework-dependent. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.2" />
    <!-- Avalonia.Skia pins SkiaSharp.NativeAssets.Linux to an older release than the managed
         SkiaSharp used by ValveResourceFormat/GUI.Shared. Reference the matching native assets
         explicitly so the managed and native Skia versions cannot drift apart. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GUI.Shared\GUI.Shared.csproj" />
    <ProjectReference Include="..\Renderer\Renderer.csproj" />
    <ProjectReference Include="..\ValveResourceFormat\ValveResourceFormat.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reused for the window icon and shipped in the Linux tarball so the desktop entry,
         the window manager and the app all show the same Source 2 Viewer icon. -->
    <AvaloniaResource Include="..\Misc\Icons\source2viewer.png" Link="Assets\source2viewer.png" />
  </ItemGroup>
</Project>
